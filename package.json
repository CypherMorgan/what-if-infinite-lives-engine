{
  "name": "what-if-infinite-lives-engine",
  "productName": "What If? — The Infinite Lives Engine",
  "version": "1.0.0",
  "description": "Explore plausible alternative versions of your life through interactive branching timelines, decisions, consequences and evolving simulations.",
  "author": "What If? Labs",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/CypherMorgan/what-if-infinite-lives-engine.git"
  },
  "bugs": {
    "url": "https://github.com/CypherMorgan/what-if-infinite-lives-engine/issues"
  },
  "homepage": "https://github.com/CypherMorgan/what-if-infinite-lives-engine#readme",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "simulation",
    "counterfactual",
    "decision-tree",
    "timeline",
    "multiverse",
    "what-if",
    "desktop-app"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:electron && electron .",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "icon": "node scripts/make-icon.cjs",
    "icon:verify": "node scripts/validate-ico.cjs",
    "appname:verify": "node scripts/validate-app-name.cjs",
    "screenshots": "node --experimental-strip-types scripts/screenshots.ts",
    "screenshots:verify": "node scripts/validate-screenshots.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "dist": "npm run build && node scripts/make-icon.cjs && electron-builder --win --publish never",
    "dist:portable": "npm run build && node scripts/make-icon.cjs && electron-builder --win portable --publish never",
    "package:win": "npm run build && node scripts/make-icon.cjs && electron-builder --win --publish never",
    "postinstall": "node scripts/ensure-electron.cjs && electron-builder install-app-deps",
    "prepare": "husky"
  },
  "dependencies": {
    "driver.js": "1.3.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "9.37.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.7.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "5.9.2",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "com.whatif.livesengine",
    "productName": "What If Infinite Lives Engine",
    "publish": [
      {
        "provider": "github",
        "owner": "CypherMorgan",
        "repo": "what-if-infinite-lives-engine",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "!**/*.map",
      "!**/*.ts"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "what-if-infinite-lives-engine-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "What If?"
    },
    "portable": {
      "artifactName": "what-if-infinite-lives-engine-Portable-${version}-${arch}.${ext}"
    },
    "compression": "normal",
    "asar": true
  }
}
